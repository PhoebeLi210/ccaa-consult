# ===========================================
# 智质通·咨询版 环境变量配置
# ===========================================
# 复制本文件为 .env 并填入实际值
# cp .env.example .env

# ---- 应用配置 ----
APP_NAME=智质通·咨询版
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ---- CORS配置 ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ---- 数据库配置 ----
DATABASE_URL=sqlite:///./data/zhizhitong.db
# PostgreSQL示例: postgresql://user:password@localhost:5432/zhizhitong
# MySQL示例: mysql+pymysql://user:password@localhost:3306/zhizhitong

# ---- LLM配置 ----
LLM_PROVIDER=deepseek
LLM_API_KEY=your_deepseek_api_key_here
LLM_API_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4000

# ---- JWT认证配置 ----
JWT_SECRET_KEY=your_jwt_secret_key_here_please_change
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# ---- 文件上传配置 ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800
# 50MB = 52428800 bytes

# ---- 文档生成配置 ----
OUTPUT_DIR=./output
TEMPLATE_DIR=./templates_industry

# ---- 日志配置 ----
LOG_LEVEL=INFO
